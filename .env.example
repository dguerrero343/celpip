# Runtime
APP_ENV=development
APP_NAME=CELPIP Writing Coach API
API_V1_PREFIX=
LOG_LEVEL=INFO
DEMO_MODE=false
# JSON list of accounts that should receive administrator access after login.
ADMIN_EMAILS=[]
HTTP_PORT=80

# Public URLs / browser security
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL (never commit the real values)
POSTGRES_DB=celpip
POSTGRES_USER=celpip_app
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+asyncpg://celpip_app:change-me-in-production@db:5432/celpip

# Authentication - generate a long random value for production
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI evaluation provider. Keep the API key server-side and out of source control.
OPENAI_API_KEY=
# Optional organization-owner Admin API key used only for the protected usage report.
# This is different from OPENAI_API_KEY and must never be exposed to the browser.
OPENAI_ADMIN_KEY=
# Strongly recommended when reconciling costs so unrelated organization usage is excluded.
OPENAI_PROJECT_ID=
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low
MAX_AI_CONTEXT_TOKENS=6000
MAX_HISTORY_ITEMS=5
MAX_RESPONSE_TOKENS=4000
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
# USD per one million tokens for OPENAI_MODEL; update these when changing models/pricing.
OPENAI_INPUT_COST_PER_MILLION=0.25
OPENAI_CACHED_INPUT_COST_PER_MILLION=0.025
OPENAI_OUTPUT_COST_PER_MILLION=2.00
